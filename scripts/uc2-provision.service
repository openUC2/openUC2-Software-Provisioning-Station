[Unit]
Description=openUC2 Provisioning Station backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is required for raw block-device writes (SD flashing) and serial access.
# The station is a dedicated appliance; lock down network access accordingly.
User=root
Environment=UC2_HOST=0.0.0.0
Environment=UC2_PORT=8000
ExecStart=/opt/uc2-provision/backend/.venv/bin/uc2-provision
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
